{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yucca-homeware",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Cloudflare creates the DNS records and certificates; the middleware redirects www to the bare domain.
  "routes": [
    { "pattern": "yuccahomeware.com", "custom_domain": true },
    { "pattern": "www.yuccahomeware.com", "custom_domain": true }
  ],
  "vars": {
    "SITE_URL": "https://yuccahomeware.com",
    "TAX_RATE": "0.16",
    "DELIVERY_FEE": "350",
    "MPESA_ENV": "sandbox",
    "EMAIL_FROM": "hello@yuccahomeware.com"
  },
  // IDs of the production resources, pinned so preview uploads (which can't inherit bindings) and deploys use
  // the same database and session store. Local dev uses Miniflare copies.
  "d1_databases": [
    { "binding": "DB", "database_name": "yucca-db", "database_id": "a31a2f05-7fd0-42e6-95d2-ea1bedee6284", "migrations_dir": "migrations" }
  ],
  // Astro sessions (the Cloudflare adapter uses the SESSION binding).
  "kv_namespaces": [{ "binding": "SESSION", "id": "a88a7608361947eda3044cee877138bc" }],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "yucca-uploads" }],
  "send_email": [{ "name": "EMAIL" }]
}

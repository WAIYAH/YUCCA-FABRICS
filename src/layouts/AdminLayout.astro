---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '~/styles/global.css';
import FormAlert from '~/components/FormAlert.astro';
import Icon from '~/components/Icon.astro';
import { adminNotifications } from '~/lib/admin-notifications';

interface Props { title: string; heading: string; intro?: string }
const { title, heading, intro } = Astro.props;
const path = Astro.url.pathname;
const sections = [
  { href: '/admin', icon: 'fa6-solid:gauge', label: 'Overview' },
  { href: '/admin/orders', icon: 'fa6-solid:bag-shopping', label: 'Orders' },
  { href: '/admin/training', icon: 'fa6-solid:chalkboard-user', label: 'Classes' },
  { href: '/admin/consultations', icon: 'fa6-solid:calendar-check', label: 'Consultations' },
  { href: '/admin/requests', icon: 'fa6-solid:couch', label: 'Service requests' },
  { href: '/admin/products', icon: 'fa6-solid:swatchbook', label: 'Products' },
  { href: '/admin/categories', icon: 'fa6-solid:tags', label: 'Categories' },
  { href: '/admin/services', icon: 'fa6-solid:scissors', label: 'Services' },
  { href: '/admin/customers', icon: 'fa6-solid:users', label: 'Customers' },
  { href: '/admin/coupons', icon: 'fa6-solid:ticket', label: 'Coupons' },
  { href: '/admin/reviews', icon: 'fa6-solid:star', label: 'Reviews' },
  { href: '/admin/content', icon: 'fa6-solid:newspaper', label: 'Journal & gallery' },
  { href: '/admin/messages', icon: 'fa6-solid:inbox', label: 'Messages' },
  { href: '/admin/reports', icon: 'fa6-solid:chart-column', label: 'Reports' },
  { href: '/admin/settings', icon: 'fa6-solid:gear', label: 'Settings' },
];
const isActive = (href: string) => (href === '/admin' ? path === '/admin' : path === href || path.startsWith(`${href}/`));
const { flash, user } = Astro.locals;
const notifications = await adminNotifications();
const waiting = notifications.reduce((sum, item) => sum + item.count, 0);
const menuLink = 'flex items-center gap-3 px-4 py-2.5 transition hover:bg-cream hover:text-forest';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · Admin · Yucca Homeware</title>
    <link rel="icon" type="image/jpeg" href="/images/yucca-homeware-logo.jpeg" />
  </head>
  <body class="admin-shell bg-sand font-sans text-ink antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="min-h-screen lg:flex">
      <!-- Desktop sidebar. Below 1024 px the same links open in the #admin-drawer popover instead. -->
      <aside class="hidden bg-forest text-white lg:sticky lg:top-0 lg:block lg:h-screen lg:w-64 lg:shrink-0 lg:overflow-y-auto">
        <a href="/admin" class="flex items-center gap-3 p-5" aria-label="Admin overview"><img src="/images/yucca-homeware-logo.jpeg" alt="" class="h-12 w-12 rounded-lg bg-white object-contain p-1" /><span class="leading-tight"><span class="block font-serif font-semibold tracking-[.18em]">YUCCA</span><span class="block text-[10px] uppercase tracking-[.3em] text-wheat">Studio admin</span></span></a>
        <nav class="grid gap-1 px-3 pb-5 text-sm" aria-label="Admin">
          {sections.map((section) => <a class:list={['admin-link', { 'is-active': isActive(section.href) }]} href={section.href} aria-current={isActive(section.href) ? 'page' : undefined}><Icon name={section.icon} class="w-4 text-wheat" />{section.label}</a>)}
        </nav>
      </aside>
      <nav id="admin-drawer" popover class="admin-drawer lg:hidden" aria-label="Admin">
        <div class="flex items-center justify-between py-3 pl-6 pr-3"><span class="text-[10px] font-semibold uppercase tracking-[.3em] text-wheat">Studio admin</span><button type="button" popovertarget="admin-drawer" popovertargetaction="hide" class="icon-button text-white hover:bg-white/10" aria-label="Close menu" autofocus><Icon name="fa6-solid:xmark" class="text-lg" /></button></div>
        <div class="grid gap-1 px-3 pb-6 text-sm">
          {sections.map((section) => <a class:list={['admin-link', { 'is-active': isActive(section.href) }]} href={section.href} aria-current={isActive(section.href) ? 'page' : undefined}><Icon name={section.icon} class="w-4 text-wheat" />{section.label}</a>)}
        </div>
      </nav>
      <div class="min-w-0 flex-1">
        <header class="sticky top-0 z-40 flex items-center gap-2 border-b border-ink/5 bg-white px-2 py-2 sm:px-5 md:px-8 lg:py-2.5">
          <button type="button" popovertarget="admin-drawer" class="icon-button lg:hidden" aria-label="Open admin menu"><Icon name="fa6-solid:bars" class="text-lg" /></button>
          <a href="/admin" class="flex min-w-0 items-center gap-2.5 lg:hidden" aria-label="Admin overview"><img src="/images/yucca-homeware-logo.jpeg" alt="" class="h-9 w-9 shrink-0 rounded-md object-contain" /><span class="leading-tight"><span class="block font-serif text-sm font-semibold tracking-[.18em]">YUCCA</span><span class="block text-[9px] uppercase tracking-[.25em] text-sage">Studio admin</span></span></a>
          <p class="hidden text-xs uppercase tracking-[.2em] text-gray-500 lg:block">Yucca Homeware · administration</p>
          <!-- Both panels anchor to this wrapper's right edge (the dropdowns are not positioned), so they stay on screen at 360 px. -->
          <div class="relative ml-auto flex items-center gap-1">
            <div class="dropdown" data-dropdown>
              <button type="button" class="icon-button relative" aria-expanded="false" aria-controls="admin-notifications" aria-label={waiting ? `Notifications: ${waiting} waiting` : 'Notifications: all caught up'}>
                <Icon name="fa6-regular:bell" class="text-lg" />
                {waiting > 0 && <span aria-hidden="true" class="absolute -right-0.5 -top-0.5 grid h-5 min-w-5 place-items-center rounded-full bg-clay px-1 text-[10px] font-semibold text-white">{waiting > 99 ? '99+' : waiting}</span>}
              </button>
              <div id="admin-notifications" class="dropdown-panel dropdown-panel-end absolute right-0 top-full z-50 w-80 max-w-[calc(100vw-2.5rem)] pt-3">
                <div class="overflow-hidden rounded-lg border border-ink/10 bg-white py-2 text-sm shadow-xl shadow-ink/10">
                  <p class="border-b border-ink/10 px-4 pb-3 pt-1 font-semibold">Needs your attention</p>
                  {notifications.length === 0
                    ? <p class="flex items-center gap-3 px-4 py-4 text-gray-600"><Icon name="fa6-solid:circle-check" class="text-sage" />You’re all caught up.</p>
                    : notifications.map((item) => <a class={menuLink} href={item.href}><Icon name={item.icon} class="w-4 shrink-0 text-sage" /><span class="flex-1">{item.label}</span><span class="rounded-full bg-cream px-2 py-0.5 text-xs font-semibold text-ink">{item.count}</span></a>)}
                </div>
              </div>
            </div>
            <div class="dropdown" data-dropdown>
              <button type="button" class="icon-button" aria-expanded="false" aria-controls="admin-profile-menu" aria-label="Profile menu"><Icon name="fa6-regular:circle-user" class="text-xl" /></button>
              <div id="admin-profile-menu" class="dropdown-panel dropdown-panel-end absolute right-0 top-full z-50 w-64 max-w-[calc(100vw-2.5rem)] pt-3">
                <div class="overflow-hidden rounded-lg border border-ink/10 bg-white py-2 text-sm shadow-xl shadow-ink/10">
                  <p class="border-b border-ink/10 px-4 pb-3 pt-1"><strong class="block truncate">{user?.name}</strong><span class="block truncate text-xs text-gray-500">{user?.email}</span></p>
                  <a class:list={[menuLink, 'mt-1']} href="/account/profile"><Icon name="fa6-regular:user" class="w-4 text-sage" />My profile</a>
                  <a class={menuLink} href="/admin/settings"><Icon name="fa6-solid:gear" class="w-4 text-sage" />Settings</a>
                  <a class={menuLink} href="/" target="_blank" rel="noopener"><Icon name="fa6-solid:arrow-up-right-from-square" class="w-4 text-sage" />View website</a>
                  <form action="/auth/logout" method="post" class="mt-1 border-t border-ink/10 pt-1"><button class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition hover:bg-cream hover:text-clay"><Icon name="fa6-solid:arrow-right-from-bracket" class="w-4" />Sign out</button></form>
                </div>
              </div>
            </div>
          </div>
        </header>
        <main id="main" tabindex="-1" class="mx-auto max-w-7xl px-4 py-5 sm:p-6 md:p-8">
          <div class="mb-5 sm:mb-6"><h1 class="font-serif text-[1.75rem] leading-tight sm:text-4xl">{heading}</h1>{intro && <p class="mt-2 max-w-2xl text-sm text-gray-600">{intro}</p>}</div>
          {flash && <FormAlert message={flash.message} type={flash.type} class="mb-6" />}
          <slot />
        </main>
      </div>
    </div>
    <script>
      import '~/scripts/site';
      const wide = window.matchMedia('(min-width: 1024px)');
      // The drawer is hidden from 1024 px, so close it if the window grows past that while it is open.
      const drawer = document.getElementById('admin-drawer');
      wide.addEventListener('change', (event) => { if (event.matches && drawer?.matches(':popover-open')) drawer.hidePopover(); });
      // Add/edit forms (AdminFormPanel) start collapsed for phones; wide screens have room to show them open.
      if (wide.matches) document.querySelectorAll<HTMLDetailsElement>('details[data-desktop-open]').forEach((panel) => { panel.open = true; });
    </script>
  </body>
</html>

---
import { and, asc, count, eq } from 'drizzle-orm';
import AdminFormPanel from '~/components/AdminFormPanel.astro';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { checked, done, int, optionalText, text } from '~/lib/admin-form';
import { constraintFailed, db, schema } from '~/lib/db';
import { slugify } from '~/lib/format';
import { deleteUpload, saveUploadedImage, UploadError } from '~/lib/uploads';

const c = schema.categories;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = int(form, 'id');
  if (form.get('intent') === 'delete' && id) {
    const [used] = await db.select({ n: count() }).from(schema.products).where(and(eq(schema.products.categoryId, id), eq(schema.products.isActive, true)));
    if ((used?.n ?? 0) > 0) return done(Astro, 'error', 'Move or hide the products in this category before deleting it.');
    const [row] = await db.delete(c).where(eq(c.id, id)).returning();
    await deleteUpload(row?.image);
    return done(Astro, 'success', 'Category deleted.', '/admin/categories');
  }
  const name = text(form, 'name', 120);
  if (!name) return done(Astro, 'error', 'Give the category a name.');
  const [existing] = id ? await db.select().from(c).where(eq(c.id, id)) : [];
  if (id && !existing) return done(Astro, 'error', 'Category not found. It may have been deleted.', '/admin/categories');
  let image: string | null;
  try {
    image = await saveUploadedImage(form.get('image') as File | null, 'categories');
  } catch (error) {
    if (error instanceof UploadError) return done(Astro, 'error', error.message);
    throw error;
  }
  const values = { name, description: optionalText(form, 'description', 1000), sortOrder: int(form, 'sort_order') ?? 0, isActive: checked(form, 'is_active'), ...(image ? { image } : {}) };
  try {
    if (existing) await db.update(c).set(values).where(eq(c.id, existing.id));
    else await db.insert(c).values({ ...values, slug: slugify(name, true) });
  } catch (error) {
    await deleteUpload(image);
    if (constraintFailed(error, 'UNIQUE')) return done(Astro, 'error', 'A category with that name already exists.');
    throw error;
  }
  // The new image replaced the old one, so the old file is no longer used.
  if (existing && image) await deleteUpload(existing.image);
  return done(Astro, 'success', existing ? 'Category updated.' : 'Category added.', '/admin/categories');
}

const categories = await db.select({ category: c, products: count(schema.products.id) }).from(c)
  .leftJoin(schema.products, eq(schema.products.categoryId, c.id)).groupBy(c.id).orderBy(asc(c.sortOrder), asc(c.name));
const edit = categories.find(({ category }) => category.id === Number(Astro.url.searchParams.get('edit')))?.category;
---
<AdminLayout title="Categories" heading="Shop categories" intro="Categories appear as tiles on the homepage and as a shop filter.">
  <div class="grid gap-6 xl:grid-cols-[.8fr_1.2fr]">
    <AdminFormPanel title={edit ? `Edit: ${edit.name}` : 'Add a category'} open={Boolean(edit)}>
      <form method="post" enctype="multipart/form-data" class="grid gap-4">
        {edit && <input type="hidden" name="id" value={edit.id} />}
        <label class="text-sm">Name<input class="form-control mt-1" name="name" required maxlength="120" value={edit?.name ?? ''} /></label>
        <label class="text-sm">Description<textarea class="form-control mt-1" name="description" rows="2" maxlength="1000">{edit?.description ?? ''}</textarea></label>
        <label class="text-sm">Display order<input class="form-control mt-1" name="sort_order" type="number" value={edit?.sortOrder ?? categories.length + 1} /><span class="mt-1 block text-xs text-gray-500">Lower numbers come first on the homepage and in the shop filter.</span></label>
        <label class="text-sm">Tile photo (optional)<input class="form-control mt-1 text-sm" name="image" type="file" accept="image/jpeg,image/png,image/webp" /></label>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="is_active" class="h-4 w-4 accent-forest" checked={edit?.isActive ?? true} />Show on the website</label>
        <div class="flex gap-4"><button class="btn-primary">{edit ? 'Save' : 'Add category'}</button>{edit && <a class="self-center text-sm underline" href="/admin/categories">Cancel</a>}</div>
      </form>
    </AdminFormPanel>
    <section class="overflow-x-auto admin-card">
      <table class="admin-table w-full text-left text-sm">
        <thead class="text-xs uppercase tracking-wider text-gray-500"><tr><th class="py-2">Order</th><th>Category</th><th>Products</th><th>Status</th><th class="text-right">Actions</th></tr></thead>
        <tbody>{categories.map(({ category, products }) => <tr class="border-t border-ink/5"><td class="py-3 pr-4 text-gray-500" data-label="Display order">{category.sortOrder}</td><td class="py-3 pr-4 max-lg:order-first"><strong>{category.name}</strong>{category.description && <><br /><span class="text-xs text-gray-500">{category.description}</span></>}</td><td class="pr-4" data-label="Products">{products}</td><td class="pr-4" data-label="Status">{category.isActive ? 'Shown' : 'Hidden'}</td><td class="admin-actions py-3"><span class="flex justify-end gap-4"><a class="underline" href={`?edit=${category.id}`}>Edit</a><form method="post" data-confirm={`Delete ${category.name}?`}><input type="hidden" name="intent" value="delete" /><input type="hidden" name="id" value={category.id} /><button class="text-[#7A2E22] underline">Delete</button></form></span></td></tr>)}</tbody>
      </table>
    </section>
  </div>
</AdminLayout>

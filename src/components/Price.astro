---
import { formatMoney, hasPrice } from '~/lib/money';

interface Props { priceCents: number; salePriceCents: number | null; unit: string }
const { priceCents, salePriceCents, unit } = Astro.props;
const onSale = salePriceCents !== null && salePriceCents < priceCents;
---
{!hasPrice(priceCents) ? 'Price on request' : onSale ? (
  <><span class="text-clay">{formatMoney(salePriceCents!)}</span> <s class="text-xs font-normal text-gray-500"><span class="sr-only">was </span>{formatMoney(priceCents)}</s></>
) : formatMoney(priceCents)}{hasPrice(priceCents) && <span class="text-xs font-normal text-gray-500"> / {unit}</span>}
